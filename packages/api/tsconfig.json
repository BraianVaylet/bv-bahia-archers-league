{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NodeNext (no Bundler): el build se ejecuta con `node dist/index.js`, así que
    // los imports relativos deben llevar extensión `.js` explícita.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    // Se anula el alias de tsconfig.base.json a propósito: el backend tiene que
    // resolver @bal/shared como lo va a resolver Node en producción, o sea por
    // los `exports` del paquete hacia `dist`. Apuntar al código fuente ocultaría
    // errores de empaquetado. Por eso `typecheck` construye shared primero.
    "paths": {}
  },
  "include": ["src"]
}

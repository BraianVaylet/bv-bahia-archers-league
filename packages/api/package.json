{
  "name": "@bal/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend de la Liga Bahiense de Arquería. Hono + MongoDB.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",

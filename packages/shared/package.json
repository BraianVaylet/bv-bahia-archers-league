{
  "name": "@bal/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dominio puro de la Liga Bahiense de Arquería. Sin I/O.",
  "sideEffects": [
    "./dist/configuracionZod.js",
    "./dist/navegador.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./navegador": {
      "types": "./dist/navegador.d.ts",
      "default": "./dist/navegador.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mutacion": "stryker run"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}

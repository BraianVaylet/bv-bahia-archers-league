{
  "name": "@bal/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PWA de la Liga Bahiense: WAFA (admin) y WAFL (líder de patrulla).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
